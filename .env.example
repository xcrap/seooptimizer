APP_URL=http://localhost:5174
DB_PATH=./database

# This app uses one local Vite server. The React app and /api routes share APP_URL.
# For production, set APP_URL to your public domain, for example:
# APP_URL=https://seo.example.com
# API_PORT and API_URL are not needed for the current single-server setup.

SEO_OPTIMIZER_PROVIDER=codex
SEO_OPTIMIZER_MODEL=gpt-5.4-mini
SEO_OPTIMIZER_REASONING_EFFORT=medium

# Optional: use the official OpenAI API instead of local Codex.
# SEO_OPTIMIZER_PROVIDER=openai
# OPENAI_API_KEY=
